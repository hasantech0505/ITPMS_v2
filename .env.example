# Copy this file to ".env" (same folder) and fill in what you need.
# Every variable is optional - the app runs without any of them.
# After changing .env, fully stop and restart the server.

# Port the server listens on (default 3000)
PORT=3000

# Live AI features (Copilot, executive brief). Free key from https://console.groq.com
# Without it the app uses offline template answers.
GROQ_API_KEY=

# Optional PostgreSQL connection (Neon / Supabase / local).
# Leave empty to use the built-in JSON file store: server/db_store.json
DATABASE_URL=

# Token signing secrets - set your own long random values for any real deployment.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Optional: Google Maps key for the property map
GOOGLE_MAPS_PLATFORM_KEY=

# Optional: where uploaded photos/documents are stored
# UPLOAD_DIR=

# Optional: allowed origins for external API clients (default *)
# CORS_ORIGIN=*

# DEVELOPMENT ONLY - skips login and treats every request as Super Admin.
# Ignored when NODE_ENV=production. Never enable on a shared server.
# AUTH_DISABLED=true

# Folder with Residents.xlsx, Events.xlsx, Startups/Startups.xlsx, TalentPool/Talent Pool.xlsx (used by npm run import:excel)
# EXCEL_SOURCE_DIR=C:\Users\you\OneDrive\...\Metadata_
